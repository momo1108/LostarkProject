// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Visit {
  count Int
  year Int                   @db.SmallInt
  month Int                  @db.TinyInt
  day Int                    @db.TinyInt
  @@id([year,month,day])
}